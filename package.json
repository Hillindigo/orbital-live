{
    "name": "orbital-live",
    "version": "0.1.0",
    "private": true,
    "engines": {
        "node": ">=22.13.0"
    },
    "scripts": {
        "dev": "vinext dev",
        "build": "vinext build",
        "start": "vinext start",
        "test": "npm run build && node --test tests/rendered-html.test.mjs tests/orbit-maintenance.test.mjs tests/tle-updater.test.mjs",
        "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
        "typecheck": "tsc --noEmit",
        "verify": "npm run lint && npm run typecheck && npm test",
        "tle:check": "node scripts/update-tle.mjs --check",
        "tle:update": "node scripts/update-tle.mjs",
        "db:generate": "drizzle-kit generate",
        "deploy:cloudflare": "npm run build && wrangler deploy --config dist/server/wrangler.json",
        "deploy:cloudflare:dry-run": "npm run build && wrangler deploy --config dist/server/wrangler.json --dry-run",
        "preview:cloudflare": "npm run build && wrangler dev --config dist/server/wrangler.json"
    },
    "dependencies": {
        "@fontsource/ibm-plex-mono": "^5.2.7",
        "@fontsource/space-grotesk": "^5.2.8",
        "@types/three": "^0.180.0",
        "drizzle-orm": "0.45.2",
        "next": "16.2.6",
        "react": "19.2.6",
        "react-dom": "19.2.6",
        "satellite.js": "^5.0.0",
        "three": "^0.180.0",
        "topojson-client": "^3.1.0",
        "world-atlas": "^2.0.2"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "1.37.1",
        "@cloudflare/workers-types": "^4.20260702.1",
        "@tailwindcss/postcss": "4.2.1",
        "@types/node": "22.19.19",
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3",
        "@types/topojson-client": "^3.1.5",
        "@vitejs/plugin-react": "6.0.2",
        "@vitejs/plugin-rsc": "0.5.26",
        "drizzle-kit": "0.31.10",
        "eslint": "9.39.4",
        "eslint-config-next": "16.2.6",
        "react-server-dom-webpack": "19.2.6",
        "tailwindcss": "4.2.1",
        "typescript": "5.9.3",
        "vinext": "0.0.50",
        "vite": "8.0.13",
        "wrangler": "4.92.0"
    },
    "type": "module"
}
